---
import Base from '../../layouts/Base.astro';
import { jobs } from '../../data/site';

export function getStaticPaths() {
  return jobs.map((job, i) => ({
    params: { slug: job.slug },
    props: { job, prev: jobs[(i - 1 + jobs.length) % jobs.length], next: jobs[(i + 1) % jobs.length] },
  }));
}
const { job, prev, next } = Astro.props;
const img = job.image;
---
<Base title={`${job.company} — ${job.role}`} description={job.overview}>
  <article class="detail">
    <a class="detail-close" href="/#experience" aria-label="Close and return to experience">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </a>
    <div>
      <span class="dates">{job.dates}</span>
      <h1>{job.company}</h1>
      <span class="role">{job.role}</span>
    </div>
    <p class="overview">{job.overview}</p>
    {img && (
      <div class="hero-img" role="img" aria-label={job.company}>
        <div style={`background-image:url('${img.src}');background-size:${img.fit};background-position:${img.fit === 'contain' ? 'center' : 'top center'};padding:${img.pad ?? '0'}`}></div>
      </div>
    )}
    <div class="detail-cols">
      <section>
        <h2 class="eyebrow">Highlights</h2>
        <ul>{job.points.map((p) => <li>{p}</li>)}</ul>
      </section>
      <section>
        <h2 class="eyebrow">Stack</h2>
        <div class="tags" style="gap:6px">{job.stack.map((t) => <span class="chip">{t}</span>)}</div>
      </section>
    </div>
    <div class="pager">
      <a href={`/experience/${prev.slug}/`}>← {prev.company}</a>
      <a href={`/experience/${next.slug}/`}>{next.company} →</a>
    </div>
  </article>
</Base>
<script>
  const card = document.querySelector<HTMLElement>('.detail');
  const close = document.querySelector<HTMLAnchorElement>('.detail-close');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let leaving = false;
  const leave = () => {
    if (!card || !close || leaving) return;
    leaving = true;
    try { sessionStorage.setItem('list-in', '1'); } catch {}
    if (calm) { location.href = close.href; return; }
    card.classList.add('closing');
    card.addEventListener('animationend', () => { location.href = close.href; }, { once: true });
  };
  close?.addEventListener('click', (e) => { e.preventDefault(); leave(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') leave(); });
</script>
