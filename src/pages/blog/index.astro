---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Writing">
  <h1 class="h2" style="font-size:clamp(34px,4.5vw,48px);margin-bottom:24px">Writing</h1>
  {posts.map((p) => (
    <a class="post-row" href={`/blog/${p.id}/`}>
      <span class="t">{p.data.title}</span>
      <span class="m">{p.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' })}</span>
    </a>
  ))}
</Base>
