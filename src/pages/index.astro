---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkShot from '../components/WorkShot.astro';
import { profile, jobs, work, toolbox } from '../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base>
  <div class="stack-sections">
    <section id="about" class="about">
      <p class="lede"><em>{profile.introEmphasis}</em> {profile.intro}</p>
      <p class="muted">{profile.about}</p>
    </section>

    <section id="experience">
      <h2 class="h2">Experience</h2>
      {jobs.map((j) => (
        <a class="exp-row" href={`/experience/${j.slug}/`}>
          <span class="dates">{j.dates}</span>
          <div class="body">
            <span class="co">{j.company} · <span>{j.role}</span></span>
            <span class="sum">{j.summary}</span>
            <span class="more">Read more →</span>
          </div>
        </a>
      ))}
    </section>

    <section id="work">
      <h2 class="h2" style="margin-bottom:20px">Selected work</h2>
      <div class="cards">
        {work.map((w) => (
          <article class="card">
            <WorkShot kind={w.shot} />
            <span class="where">{w.where}</span>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
            <div class="tags">{w.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 class="h2" style="margin-bottom:16px">Toolbox</h2>
      <div class="tags" style="gap:8px">{toolbox.map((c) => <span class="chip">{c}</span>)}</div>
    </section>

    {posts.length > 0 && (
      <section id="writing">
        <h2 class="h2">Writing</h2>
        {posts.map((p) => (
          <a class="post-row" href={`/blog/${p.id}/`}>
            <span class="t">{p.data.title}</span>
            <span class="m">{p.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </a>
        ))}
        <a class="post-row" href="/blog/"><span class="more">All posts →</span></a>
      </section>
    )}
  </div>
</Base>
<script>
  try {
    if (sessionStorage.getItem('list-in')) {
      sessionStorage.removeItem('list-in');
      document.querySelector('.stack-sections')?.classList.add('list-in');
    }
  } catch {}
</script>
