---
interface Props { kind: 'review' | 'gridshift' | 'booking' | 'ds'; }
const { kind } = Astro.props;
const days = Array.from({ length: 12 }, (_, i) => i === 6);
const curve = [40.6, 41.5, 42.5, 42.9, 42.0, 39.2, 33.2, 26.8, 29.5, 35.1, 37.8, 36.0, 31.8, 19.4, 4.6, 15.7, 27.7, 31.4, 34.6, 36.9];
const line = curve.map((y, i) => `${i ? 'L' : 'M'}${((i * 200) / (curve.length - 1)).toFixed(1)} ${y}`).join(' ');
const heat = [[0, .85], [0, .6], [1, .7], [0, .4], [0, .55], [1, .9], [0, .35], [0, .65]];
---
<div class="shot" aria-hidden="true">
  {kind === 'review' && (
    <div class="review">
      <div class="row"><span class="bar" style="width:34%;background:var(--ink)"></span><span class="mr">MR !482</span></div>
      <div class="diff">
        <div class="ln" style="color:var(--muted)">  const items = data.map(…)</div>
        <div class="ln" style="background:color-mix(in oklch,var(--accent) 14%,transparent)">- useEffect(() =&gt; fetch(url))</div>
        <div class="ln" style="background:color-mix(in oklch,oklch(0.7 0.12 150) 20%,transparent)">+ const q = useQuery(key, fn)</div>
        <div class="comment">
          <span class="who">● review-agent</span>
          <span class="bar" style="width:92%;background:var(--line)"></span>
          <span class="bar" style="width:64%;background:var(--line)"></span>
        </div>
      </div>
    </div>
  )}
  {kind === 'gridshift' && (
    <div class="gs">
      <div class="gs-head">
        <span class="gs-name">GridShift</span>
        <span class="gs-live"><span class="dot"></span>LIVE · HB_NORTH</span>
        <span class="gs-price">$31.42<span class="unit">/MWh</span></span>
      </div>
      <div class="gs-body">
        <div class="panel gs-chart">
          <span class="cap">Real-time price · 24h</span>
          <svg viewBox="0 0 200 60" preserveAspectRatio="none">
            <rect x="0" y="0" width="60" height="60" fill="oklch(0.68 0.14 150 / 0.12)" />
            <path d={`${line} L200 60 L0 60 Z`} fill="color-mix(in oklch, var(--accent) 14%, transparent)" />
            <path d={line} fill="none" stroke="var(--accent)" stroke-width="1.6" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
        <div class="gs-side">
          <div class="panel stat"><span class="cap">Cheapest window</span><span class="val">1–5 AM</span></div>
          <div class="panel heat">
            {heat.map(([accent, o]) => <span style={`background:${accent ? 'var(--accent)' : 'oklch(0.68 0.14 150)'};opacity:${o}`}></span>)}
          </div>
        </div>
      </div>
    </div>
  )}
  {kind === 'booking' && (
    <div class="phones">
      <div class="phone">
        <span class="bar" style="width:70%;background:var(--ink)"></span>
        <div class="cal">{days.map((on) => <span style={`background:var(--${on ? 'accent' : 'soft'})`}></span>)}</div>
      </div>
      <div class="phone">
        <span class="bar" style="width:60%;background:var(--ink)"></span>
        <span class="slot"></span>
        <span class="slot" style="border-color:var(--accent);background:color-mix(in oklch,var(--accent) 18%,transparent)"></span>
        <span class="slot"></span>
      </div>
      <div class="phone">
        <span class="check">✓</span>
        <span class="bar" style="width:80%;background:var(--ink)"></span>
        <span class="bar" style="width:55%;background:var(--line)"></span>
      </div>
    </div>
  )}
  {kind === 'ds' && (
    <div class="ds">
      <div class="nav">
        <span class="bar" style="width:80%;background:var(--ink)"></span>
        <span class="bar" style="width:60%;background:var(--line)"></span>
        <span class="bar" style="width:70%;background:var(--accent)"></span>
        <span class="bar" style="width:50%;background:var(--line)"></span>
        <span class="bar" style="width:65%;background:var(--line)"></span>
      </div>
      <div class="demo-grid">
        <span style="height:20px;border-radius:6px;background:var(--accent)"></span>
        <span style="height:20px;border-radius:6px;border:1.5px solid var(--accent)"></span>
        <span class="input"><span class="bar" style="width:40%;background:var(--line)"></span></span>
        <span class="toggle"><span class="pill"></span><span class="bar" style="width:50%;background:var(--line)"></span></span>
        <span class="chips"><span>chip</span><span>chip</span></span>
      </div>
    </div>
  )}
</div>

<style>
  .shot { aspect-ratio: 16/10; position: relative; border-radius: 12px; overflow: hidden; background: var(--soft); }
  .bar { display: block; height: 6px; border-radius: 3px; }

  .review { position: absolute; inset: 0; padding: 14px; display: grid; grid-template-rows: auto 1fr; gap: 10px; font-family: ui-monospace, monospace; font-size: 10px; line-height: 1.5; }
  .review .row { display: flex; gap: 8px; align-items: center; }
  .review .row .bar { height: 7px; }
  .mr { margin-left: auto; padding: 1px 8px; border-radius: 999px; background: var(--accent); color: var(--bg); font-family: var(--font-body); font-weight: 600; }
  .diff { border: 1px solid var(--line); border-radius: 8px; background: var(--bg); overflow: hidden; display: grid; align-content: start; }
  .ln { padding: 3px 10px; white-space: pre; }
  .comment { margin: 8px 10px; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--card); display: grid; gap: 5px; font-family: var(--font-body); }
  .who { font-weight: 700; color: var(--accent); }

  .gs { position: absolute; inset: 0; padding: 12px 14px; display: grid; grid-template-rows: auto 1fr; gap: 8px; font-family: var(--font-body); }
  .gs-head { display: flex; align-items: center; gap: 8px; }
  .gs-name { font-weight: 700; font-size: 12px; color: var(--ink); }
  .gs-live { display: flex; align-items: center; gap: 4px; font-size: 9px; color: var(--muted); }
  .gs-live .dot { width: 6px; height: 6px; border-radius: 50%; background: oklch(0.68 0.14 150); }
  .gs-price { margin-left: auto; font-family: ui-monospace, monospace; font-size: 13px; font-weight: 600; color: var(--accent); }
  .gs-price .unit { font-size: 9px; color: var(--muted); font-weight: 400; }
  .gs-body { display: grid; grid-template-columns: 1fr 32%; gap: 8px; min-height: 0; }
  .panel { border: 1px solid var(--line); border-radius: 8px; background: var(--bg); }
  .gs-chart { padding: 8px; display: grid; grid-template-rows: auto 1fr; gap: 4px; min-height: 0; }
  .gs-chart svg { width: 100%; height: 100%; overflow: visible; }
  .cap { font-size: 9px; color: var(--muted); }
  .gs-side { display: grid; gap: 6px; align-content: start; }
  .stat { padding: 6px 8px; display: grid; gap: 2px; }
  .stat .cap { font-size: 8px; }
  .stat .val { font-size: 11px; font-weight: 600; color: oklch(0.55 0.13 150); }
  .heat { padding: 6px 8px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; }
  .heat span { aspect-ratio: 1; border-radius: 2px; }

  .phones { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 5%; }
  .phone { width: 26%; height: 88%; border-radius: 12px; border: 1.5px solid var(--line); background: var(--bg); padding: 8px 7px; display: grid; align-content: start; gap: 6px; }
  .phone .bar { height: 5px; }
  .cal { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; margin-top: 4px; }
  .cal span { aspect-ratio: 1; border-radius: 3px; }
  .slot { display: block; height: 12px; border-radius: 4px; border: 1px solid var(--line); }
  .check { width: 22px; height: 22px; border-radius: 50%; background: var(--accent); margin: 10px auto 2px; display: flex; align-items: center; justify-content: center; color: var(--bg); font-size: 12px; font-weight: 700; }

  .ds { position: absolute; inset: 0; display: grid; grid-template-columns: 22% 1fr; }
  .nav { border-right: 1px solid var(--line); padding: 12px 10px; display: grid; align-content: start; gap: 7px; }
  .nav .bar:first-child { height: 5px; }
  .demo-grid { padding: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-content: center; }
  .input { grid-column: 1/-1; height: 22px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); display: flex; align-items: center; padding: 0 8px; }
  .toggle { display: flex; gap: 6px; align-items: center; }
  .pill { width: 26px; height: 14px; border-radius: 999px; background: var(--accent); }
  .chips { display: flex; gap: 6px; }
  .chips span { padding: 2px 8px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); font-size: 9px; color: var(--muted); }
</style>
